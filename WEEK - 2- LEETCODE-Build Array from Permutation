import java.util.*;

class Solution {
    public int[] buildArray(int[] nums) {
        int n = nums.length;

        // Store both old and new values
        for (int i = 0; i < n; i++) {
            nums[i] = nums[i] + n * (nums[nums[i]] % n);
        }

        // Extract the new values
        for (int i = 0; i < n; i++) {
            nums[i] = nums[i] / n;
        }

        return nums;
    }
}

